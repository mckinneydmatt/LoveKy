{
  "name": "bakery-site",
  "private": true,
  "version": "1.0.0",
  "main": "package.json",
  "license": "UNLICENSED",
  "scripts": {
    "build": "sanity build",
    "deploy": "sanity deploy",
    "deploy-graphql": "sanity graphql deploy",
    "dev": "sanity dev",
    "seed": "sanity exec seed/seedSiteSettings.ts --with-user-token",
    "seed:products": "sanity exec seed/seedProducts.ts --with-user-token",
    "seed:carousel": "sanity exec seed/seedCarouselPhotos.ts --with-user-token",
    "seed:all": "npm run seed && npm run seed:products && npm run seed:carousel",
    "start": "sanity start"
  },
  "keywords": [
    "sanity"
  ],
  "dependencies": {
    "@sanity/vision": "^5.30.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sanity": "^5.30.0",
    "styled-components": "^6.1.18"
  },
  "devDependencies": {
    "@sanity/eslint-config-studio": "^6.0.0",
    "@types/react": "^19.2.14",
    "eslint": "^9.28",
    "prettier": "^3.5",
    "typescript": "^5.8"
  },
  "prettier": {
    "bracketSpacing": false,
    "printWidth": 100,
    "semi": false,
    "singleQuote": true
  }
}
