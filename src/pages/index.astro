---
import BaseLayout from "../layouts/BaseLayout.astro";
import ReviewCard from "../components/ReviewCard.astro";
import InstagramEmbed from "../components/InstagramEmbed.astro";
import Carousel from "../components/Carousel.astro";
import { pageDescriptions } from "../content/seo";
import { getSite } from "../lib/getSite";

const site = await getSite();
const descriptions = pageDescriptions(site);
const featuredReviews = site.reviews.slice(0, 2);
---

<BaseLayout title="Home" description={descriptions.home}>
  <section class="relative overflow-hidden border-b border-soft-blossom/60">
    <div
      class="absolute inset-0 pattern-bg pointer-events-none"
      aria-hidden="true"
    >
    </div>
    <div
      class="container-page relative grid items-center gap-8 pb-6 pt-4 sm:gap-10 sm:pb-8 sm:pt-6 md:grid-cols-[1fr_1.15fr] lg:pb-10 lg:pt-8"
    >
      <div class="text-center md:text-left">
        <h1 class="mb-4 sm:mb-6">
          <img
            src={site.logos.primary}
            alt=""
            class="mx-auto h-20 w-auto sm:h-24 md:mx-0"
            width="320"
            height="96"
            aria-hidden="true"
          />
          <span class="sr-only">{site.name}</span>
        </h1>
        {site.tagline && <p class="tagline tagline-lg mb-3">{site.tagline}</p>}
        <p
          class="mx-auto mb-8 max-w-md text-base text-blue-slate/90 sm:text-lg md:mx-0"
        >
          {site.description}
        </p>
        <div
          class="flex flex-col gap-3 sm:flex-row sm:flex-wrap md:justify-start justify-center"
        >
          <a href="/order" class="btn-blush w-full sm:w-auto">Order a Cake</a>
          <a href="/about" class="btn-secondary w-full sm:w-auto">About Us</a>
        </div>
      </div>

      <div class="relative mx-auto w-full max-w-md md:max-w-none">
        <Carousel
          framed
          label="Featured cakes"
          photos={[
            {
              src: "/carousel/love ky cakes-97.jpg",
              alt: "Slice of chocolate layer cake with whipped chocolate frosting",
            },

            {
              src: "/carousel/love ky cakes-6.jpg",
              alt: "Slice of chocolate layer cake with whipped chocolate frosting",
            },
            {
              src: "/carousel/love ky cakes-44.jpg",
              alt: "Piping buttercream detail in powder blush pink",
            },

            {
              src: "/carousel/love ky cakes-16.jpg",
              alt: "Chocolate layer cake with whipped icing on a wooden stand",
            },

            {
              src: "/carousel/love ky cakes-115.jpg",
              alt: "Slice of chocolate layer cake with whipped chocolate frosting",
            },
          ]}
        />
      </div>
    </div>
  </section>

  <section
    class="container-page section-pad overflow-visible"
    aria-labelledby="home-spotlight-heading"
  >
    <div class="home-spotlight">
      <figure class="home-spotlight-photo">
        {
          site.home.spotlight.image ? (
            <img
              src={site.home.spotlight.image}
              alt="Chocolate layer cake with whipped icing on a wooden stand"
              class="block h-full w-full object-cover"
              width="540"
              height="720"
            />
          ) : (
            <div class="flex h-full min-h-full items-center justify-center px-4 py-8 text-center text-sm font-semibold uppercase tracking-wide text-frozen-water/80">
              Photo coming soon
            </div>
          )
        }
      </figure>
      <div class="home-spotlight-copy">
        <h2 id="home-spotlight-heading" class="tagline tagline-lg mb-2">
          {site.home.spotlight.title}
        </h2>
        <p
          class="mb-3 text-lg font-semibold tracking-wide text-blue-slate sm:text-xl lg:text-2xl"
        >
          {site.home.spotlight.subhead}
        </p>
        <p>{site.home.spotlight.text}</p>
        <p class="home-spotlight-ingredient-note">
          {site.home.spotlight.ingredientNote}
        </p>
        <div class="home-spotlight-cta">
          <a href="/order" class="btn-blush">{site.home.spotlight.ctaLabel}</a>
          <p class="home-spotlight-secondary">
            {site.home.spotlight.secondaryLine}
          </p>
        </div>
      </div>
    </div>
  </section>

  <section
    class="container-page section-pad"
    aria-labelledby="home-reviews-heading"
  >
    <div
      class="mb-8 flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-end"
    >
      <div>
        <h2 id="home-reviews-heading" class="section-heading">Reviews</h2>
        <p class="mt-2 text-blue-slate/70">What customers are saying</p>
      </div>
      <a
        href="/reviews"
        class="text-sm font-semibold uppercase tracking-wide text-vintage-berry hover:text-powder-blush"
      >
        See all reviews →
      </a>
    </div>
    <div class="grid gap-6 md:grid-cols-2">
      {
        featuredReviews.map((review) => (
          <ReviewCard
            quote={review.quote}
            author={review.author}
            isPlaceholder={review.isPlaceholder}
          />
        ))
      }
    </div>
  </section>

  <section
    class="section-pad border-y border-soft-blossom/60 bg-soft-blossom/20"
    aria-labelledby="home-instagram-heading"
  >
    <div class="container-page">
      <div class="mb-8 text-center">
        <img
          src="/icons/cake-icon-powder-blush.png"
          alt=""
          class="mx-auto mb-4 h-10 w-10"
          width="40"
          height="40"
          aria-hidden="true"
        />
        <h2 id="home-instagram-heading" class="section-heading mb-3">
          Follow along
        </h2>
        <p class="text-blue-slate/80">See Ky's latest creations on Instagram</p>
      </div>
      <InstagramEmbed />
    </div>
  </section>
</BaseLayout>
