---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProductCard from "../components/ProductCard.astro";
import ReviewCard from "../components/ReviewCard.astro";
import InstagramEmbed from "../components/InstagramEmbed.astro";
import { pageDescriptions } from "../content/seo";
import { getProducts } from "../lib/getProducts";
import { getSite } from "../lib/getSite";

const site = await getSite();
const products = await getProducts();
const descriptions = pageDescriptions(site);
const featuredReviews = site.reviews.slice(0, 2);
---

<BaseLayout title="Home" description={descriptions.home}>
  <section class="relative overflow-hidden border-b border-soft-blossom/60">
    <div class="absolute inset-0 pattern-bg pointer-events-none" aria-hidden="true"></div>
    <div class="container-page relative grid items-center gap-8 py-12 sm:gap-10 sm:py-16 lg:grid-cols-2 lg:py-24">
      <div>
        <h1 class="mb-6">
          <img
            src={site.logos.primary}
            alt=""
            class="h-20 w-auto sm:h-24"
            width="320"
            height="96"
            aria-hidden="true"
          />
          <span class="sr-only">{site.name}</span>
        </h1>
        {
          site.tagline && (
            <p class="tagline mb-3 text-2xl sm:text-3xl">{site.tagline}</p>
          )
        }
        <p class="mb-8 max-w-md text-lg text-blue-slate/90">
          {site.description}
        </p>
        <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <a href="/order" class="btn-primary w-full sm:w-auto">Order a Cake</a>
          <a href="/about" class="btn-secondary w-full sm:w-auto">About Ky</a>
        </div>
      </div>

      <div class="relative">
        <div class="overflow-hidden rounded-3xl border-4 border-soft-blossom bg-soft-blossom/30 shadow-lg">
          {
            site.about.image ? (
              <img
                src={site.about.image}
                alt="Ky, owner of Love, Ky Cakes"
                class="h-64 w-full object-cover sm:h-80"
                width="640"
                height="480"
              />
            ) : (
              <>
                <img
                  src="/patterns/cake-full-color.png"
                  alt=""
                  class="h-64 w-full object-cover opacity-80 sm:h-80"
                  width="640"
                  height="480"
                  aria-hidden="true"
                />
                <p class="px-6 py-4 text-center text-sm text-blue-slate/70">
                  Owner photo coming soon
                </p>
              </>
            )
          }
        </div>
      </div>
    </div>
  </section>

  <section class="container-page py-16" aria-labelledby="home-products-heading">
    <div class="mb-8 flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-end">
      <div>
        <h2 id="home-products-heading" class="section-heading">Our cakes</h2>
        <p class="mt-2 text-blue-slate/70">Pick your favorite, then request delivery</p>
      </div>
      <a href="/order" class="text-sm font-semibold uppercase tracking-wide text-vintage-berry hover:text-powder-blush">
        Order now →
      </a>
    </div>
    <div class="grid gap-6 md:grid-cols-3">
      {products.map((product) => <ProductCard product={product} />)}
    </div>
  </section>

  <section class="container-page py-16" aria-labelledby="home-reviews-heading">
    <div class="mb-8 flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-end">
      <div>
        <h2 id="home-reviews-heading" class="section-heading">Reviews</h2>
        <p class="mt-2 text-blue-slate/70">What customers are saying</p>
      </div>
      <a href="/reviews" class="text-sm font-semibold uppercase tracking-wide text-vintage-berry hover:text-powder-blush">
        See all reviews →
      </a>
    </div>
    <div class="grid gap-6 md:grid-cols-2">
      {
        featuredReviews.map((review) => (
          <ReviewCard
            quote={review.quote}
            author={review.author}
            isPlaceholder={review.isPlaceholder}
          />
        ))
      }
    </div>
  </section>

  <section
    class="border-y border-soft-blossom/60 bg-soft-blossom/20 py-16"
    aria-labelledby="home-instagram-heading"
  >
    <div class="container-page">
      <div class="mb-8 text-center">
        <img
          src="/icons/cake-icon-powder-blush.png"
          alt=""
          class="mx-auto mb-4 h-10 w-10"
          width="40"
          height="40"
          aria-hidden="true"
        />
        <h2 id="home-instagram-heading" class="section-heading mb-3">Follow along</h2>
        <p class="text-blue-slate/80">See Ky's latest creations on Instagram</p>
      </div>
      <InstagramEmbed />
    </div>
  </section>
</BaseLayout>
