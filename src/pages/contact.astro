---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../content/site";
---

<BaseLayout title="Contact">
  <section class="container-page py-12 sm:py-16">
    <h1 class="section-heading mb-4">Contact</h1>
    <p class="mb-10 max-w-2xl text-blue-slate/80">
      The best way to reach Ky is by phone or text during business hours. You can also send an
      email anytime.
    </p>

    <div class="grid gap-8 sm:grid-cols-2 lg:max-w-3xl">
      <div class="rounded-2xl border border-soft-blossom bg-white/70 p-6 shadow-sm">
        <h2 class="mb-4 text-sm font-semibold uppercase tracking-widest text-vintage-berry">
          Call or text
        </h2>
        <a
          href={`tel:${site.contact.phone}`}
          class="text-2xl font-semibold text-blue-slate hover:text-vintage-berry"
        >
          {site.contact.phone}
        </a>
        <p class="mt-3 text-sm text-blue-slate/80">{site.contact.hours}</p>
      </div>

      <div class="rounded-2xl border border-soft-blossom bg-white/70 p-6 shadow-sm">
        <h2 class="mb-4 text-sm font-semibold uppercase tracking-widest text-vintage-berry">
          Email
        </h2>
        <a
          href={`mailto:${site.contact.email}`}
          class="text-lg font-medium text-blue-slate hover:text-vintage-berry break-all"
        >
          {site.contact.email}
        </a>
        <p class="mt-3 text-sm text-blue-slate/80">{site.contact.location}</p>
      </div>
    </div>

    <div class="mt-10">
      <a href="/order" class="btn-primary">Ready to order? Submit a request</a>
    </div>
  </section>
</BaseLayout>
