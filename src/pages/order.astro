---
import BaseLayout from "../layouts/BaseLayout.astro";
import OrderForm from "../components/OrderForm.astro";
import { pageDescriptions } from "../content/seo";
import { getProducts } from "../lib/getProducts";
import { getSite } from "../lib/getSite";

const site = await getSite();
const products = await getProducts();
const descriptions = pageDescriptions(site);
---

<BaseLayout title="Order" description={descriptions.order}>
  <section class="container-page section-pad">
    <div class="mb-10 max-w-2xl">
      <h1 class="section-heading mb-4">Good Taste Awaits...</h1>
      {site.order.intro && <p class="text-blue-slate/80">{site.order.intro}</p>}
    </div>

    <div class="max-w-2xl">
      <OrderForm site={site} products={products} />
    </div>

    {
      site.order.ingredients.sections.length > 0 && (
        <div class="mt-10 max-w-2xl rounded-2xl border border-soft-blossom bg-frozen-water/70 p-6 sm:p-8">
          <h2 class="mb-4 text-lg font-semibold text-blue-slate">{site.order.ingredients.heading}</h2>
          <dl class="space-y-4">
            {site.order.ingredients.sections.map((section) => (
              <div>
                <dt class="text-sm font-semibold text-blue-slate">{section.heading}</dt>
                <dd class="mt-1 text-sm text-blue-slate/80">{section.body}</dd>
              </div>
            ))}
          </dl>
        </div>
      )
    }

    <div class="mt-10 max-w-2xl rounded-2xl border border-soft-blossom bg-soft-blossom/20 p-6 sm:p-8">
      {
        site.order.message.map((paragraph, index) => (
          <p
            class:list={[
              "leading-relaxed text-blue-slate/90",
              index < site.order.message.length - 1 && "mb-4",
            ]}
          >
            {paragraph}
          </p>
        ))
      }
    </div>
  </section>
</BaseLayout>
