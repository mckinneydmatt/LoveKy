---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../content/site";
import { pageDescriptions } from "../content/seo";
---

<BaseLayout title="About" description={pageDescriptions.about}>
  <section class="container-page py-12 sm:py-16">
    <div class="grid items-start gap-8 sm:gap-10 lg:grid-cols-2">
      <div class="order-2 lg:order-1">
        <h1 class="tagline mb-2 text-2xl sm:text-3xl">{site.about.title}</h1>
        <p class="mb-6 text-xl font-semibold tracking-wide text-blue-slate sm:text-2xl">
          {site.about.subhead}
        </p>
        <div class="space-y-4 text-blue-slate/90 leading-relaxed">
          {
            site.about.paragraphs.map((paragraph) => (
              <p
                class:list={[
                  paragraph === site.about.pullQuote && "tagline about-pull-quote",
                ]}
                set:html={paragraph}
              />
            ))
          }
        </div>
        <img
          src={site.about.signatureImage}
          alt="Ky's handwritten signature"
          class="mt-8 ml-auto mr-10 block h-24 w-auto sm:mr-20 sm:h-32"
          width="280"
          height="112"
        />
      </div>

      <div class="order-1 space-y-4 overflow-visible lg:order-2">
        <div class="overflow-hidden rounded-3xl border-4 border-soft-blossom bg-soft-blossom/30 shadow-lg">
          {
            site.about.image ? (
              <img
                src={site.about.image}
                alt="Ky, owner of Love, Ky Cakes"
                class="aspect-[4/5] w-full object-cover"
                width="640"
                height="800"
              />
            ) : (
              <div class="flex aspect-[4/5] flex-col items-center justify-center px-6 text-center">
                <img
                  src="/icons/cake-icon-powder-blush.png"
                  alt=""
                  class="mb-4 h-12 w-12 opacity-60"
                  width="48"
                  height="48"
                  aria-hidden="true"
                />
                <p class="text-blue-slate/70">Owner photo coming soon</p>
              </div>
            )
          }
        </div>

        <div class="about-gallery space-y-4">
          {
            site.about.galleryPhotos.map((photo) => (
              <figure
                class:list={[
                  "about-gallery-photo",
                  photo.side === "right"
                    ? "about-gallery-photo--right"
                    : "about-gallery-photo--left",
                ]}
              >
                {
                  photo.image ? (
                    <img
                      src={photo.image}
                      alt=""
                      class="block h-full w-full object-cover"
                      width="320"
                      height="400"
                    />
                  ) : (
                    <div class="flex h-full min-h-full items-center justify-center px-3 py-6 text-center text-xs font-semibold uppercase tracking-wide text-blue-slate/60">
                      Photo coming soon
                    </div>
                  )
                }
              </figure>
            ))
          }
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
