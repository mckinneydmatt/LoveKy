---
import { site } from "../content/site";

const formAction = site.formEndpoints.order || undefined;
const priceDisplay = site.order.price ?? "Price TBD";
---

<form
  class="space-y-6 rounded-2xl border border-soft-blossom bg-frozen-water/70 p-4 shadow-sm sm:p-8"
  method="POST"
  action={formAction}
>
  {!formAction && (
    <p class="rounded-lg bg-frozen-water/30 px-4 py-3 text-sm break-words text-blue-slate">
      Formspree is not configured yet. Add your endpoint URL to{" "}
      <code class="break-all text-vintage-berry">site.formEndpoints.order</code> in{" "}
      <code class="break-all text-vintage-berry">src/content/site.ts</code>.
    </p>
  )}

  <div class="rounded-lg border border-vintage-berry/20 bg-frozen-water p-4">
    <h2 class="text-lg font-semibold text-blue-slate">{site.order.product}</h2>
    <p class="mt-1 text-sm text-blue-slate/80">{priceDisplay}</p>
    <p class="mt-2 text-sm text-blue-slate/70">{site.order.pickupNote}</p>
  </div>

  <div class="grid gap-4 sm:grid-cols-2">
    <div>
      <label for="name" class="mb-1 block text-sm font-medium text-blue-slate">Name *</label>
      <input
        type="text"
        id="name"
        name="name"
        required
        class="form-input"
      />
    </div>
    <div>
      <label for="email" class="mb-1 block text-sm font-medium text-blue-slate">Email *</label>
      <input
        type="email"
        id="email"
        name="email"
        required
        class="form-input"
      />
    </div>
  </div>

  <div class="grid gap-4 sm:grid-cols-2">
    <div>
      <label for="phone" class="mb-1 block text-sm font-medium text-blue-slate">Phone *</label>
      <input
        type="tel"
        id="phone"
        name="phone"
        required
        class="form-input"
      />
    </div>
    <div>
      <label for="pickup-date" class="mb-1 block text-sm font-medium text-blue-slate">
        Preferred pickup date *
      </label>
      <input
        type="date"
        id="pickup-date"
        name="pickup-date"
        required
        class="form-input"
      />
    </div>
  </div>

  <div>
    <label for="quantity" class="mb-1 block text-sm font-medium text-blue-slate">Quantity</label>
    <input
      type="number"
      id="quantity"
      name="quantity"
      min="1"
      value="1"
      class="form-input max-w-xs"
    />
  </div>

  <input type="hidden" name="product" value={site.order.product} />

  <div>
    <label for="instructions" class="mb-1 block text-sm font-medium text-blue-slate">
      Special instructions
    </label>
    <textarea
      id="instructions"
      name="instructions"
      rows="4"
      placeholder="Allergies, occasion, decoration requests..."
      class="form-input min-h-28"
    ></textarea>
  </div>

  {
    site.order.ingredients && (
      <div>
        <h3 class="mb-2 text-sm font-semibold uppercase tracking-wide text-blue-slate">
          Ingredients
        </h3>
        <p class="text-sm text-blue-slate/80">{site.order.ingredients}</p>
      </div>
    )
  }

  <div class="rounded-lg border border-blue-slate/10 bg-soft-blossom/20 p-4">
    <p class="text-sm font-medium text-blue-slate">{site.order.disclaimer}</p>
    <label class="mt-3 flex cursor-pointer items-start gap-3">
      <input
        type="checkbox"
        name="disclaimer-ack"
        required
        class="mt-1 h-5 w-5 shrink-0 rounded border-soft-blossom text-vintage-berry focus:ring-vintage-berry"
      />
      <span class="text-sm text-blue-slate/90">
        I understand and agree to the above disclaimer. *
      </span>
    </label>
  </div>

  <button type="submit" class="btn-primary w-full sm:w-auto" disabled={!formAction}>
    Submit Order Request
  </button>
</form>

<script>
  const dateInput = document.getElementById("pickup-date") as HTMLInputElement | null;
  if (dateInput) {
    const tomorrow = new Date();
    tomorrow.setDate(tomorrow.getDate() + 1);
    dateInput.min = tomorrow.toISOString().split("T")[0];
  }
</script>
