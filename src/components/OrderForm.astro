---
import type { Product } from "../content/products";
import type { SiteConfig } from "../content/site";

interface Props {
  site: SiteConfig;
  products: Product[];
}

const { site, products } = Astro.props;

const formAction = site.formEndpoints.order || undefined;
const defaultProduct = products[0];
const priceDisplay = defaultProduct?.price ?? "Price TBD";
const multipleProducts = products.length > 1;
const { cakeType, frosting, sprinkles, fulfillment, hearAboutUs } = site.order.form;
---

<div id="order-form-wrapper">
<form
  id="order-form"
  class="space-y-6 rounded-2xl border border-soft-blossom bg-frozen-water/70 p-4 shadow-sm sm:p-8"
  method="POST"
  action={formAction}
  data-endpoint={formAction}
  aria-labelledby="order-form-heading"
>
  {!formAction && (
    <p
      id="form-config-notice"
      role="status"
      class="rounded-lg bg-frozen-water/30 px-4 py-3 text-sm break-words text-blue-slate"
    >
      Formspree is not configured yet. Add your endpoint URL in Sanity under{" "}
      <strong class="text-vintage-berry">Site Settings → Formspree order endpoint</strong>.
    </p>
  )}

  {
    multipleProducts && (
      <fieldset class="space-y-3">
        <legend class="mb-1 text-sm font-semibold uppercase tracking-wide text-blue-slate">
          {site.order.form.chooseCakeLabel}
        </legend>
        <div class="grid gap-3">
          {
            products.map((product, index) => {
              const productPrice = product.price ?? "Price TBD";
              return (
                <label
                  class="product-option block cursor-pointer rounded-lg border border-vintage-berry/20 bg-frozen-water p-4 transition has-[:checked]:border-vintage-berry has-[:checked]:ring-2 has-[:checked]:ring-vintage-berry/30"
                  data-product-name={product.name}
                  data-product-price={productPrice}
                  data-product-gluten-free-price={product.glutenFreePrice ?? ""}
                  data-product-serving-info={product.servingInfo ?? ""}
                  data-product-description={product.description ?? ""}
                >
                  <div class="flex items-start gap-3">
                    <input
                      type="radio"
                      name="product-choice"
                      value={product.id}
                      class="mt-1 h-5 w-5 shrink-0 border-soft-blossom text-vintage-berry focus:ring-vintage-berry"
                      checked={index === 0}
                      required
                    />
                    <span class="min-w-0">
                      <span class="block text-base font-semibold text-blue-slate">{product.name}</span>
                      <span class="mt-1 block text-sm text-vintage-berry">{productPrice}</span>
                      {product.servingInfo && (
                        <span class="mt-1 block text-xs text-blue-slate/70">{product.servingInfo}</span>
                      )}
                    </span>
                  </div>
                </label>
              );
            })
          }
        </div>
      </fieldset>
    )
  }

  <fieldset class="space-y-3">
    <legend class="mb-1 text-sm font-semibold uppercase tracking-wide text-blue-slate">
      {cakeType.label}
    </legend>
    <div class="flex flex-wrap gap-3">
      <label class="cursor-pointer rounded-lg border border-vintage-berry/20 bg-frozen-water px-4 py-2 text-sm has-[:checked]:border-vintage-berry has-[:checked]:ring-2 has-[:checked]:ring-vintage-berry/30">
        <input
          type="radio"
          name="cake-type"
          value="regular"
          data-cake-type="regular"
          class="mr-2 align-middle text-vintage-berry focus:ring-vintage-berry"
          checked
          required
        />
        {cakeType.regularLabel}
      </label>
      <label class="cursor-pointer rounded-lg border border-vintage-berry/20 bg-frozen-water px-4 py-2 text-sm has-[:checked]:border-vintage-berry has-[:checked]:ring-2 has-[:checked]:ring-vintage-berry/30">
        <input
          type="radio"
          name="cake-type"
          value="gluten-free"
          data-cake-type="gluten-free"
          class="mr-2 align-middle text-vintage-berry focus:ring-vintage-berry"
          required
        />
        {cakeType.glutenFreeLabel}
      </label>
    </div>
  </fieldset>

  <fieldset class="space-y-3">
    <legend class="mb-1 text-sm font-semibold uppercase tracking-wide text-blue-slate">
      {frosting.label}
    </legend>
    <div class="flex flex-wrap gap-3">
      {
        frosting.options.map((option, index) => (
          <label class="cursor-pointer rounded-lg border border-vintage-berry/20 bg-frozen-water px-4 py-2 text-sm has-[:checked]:border-vintage-berry has-[:checked]:ring-2 has-[:checked]:ring-vintage-berry/30">
            <input
              type="radio"
              name="frosting"
              value={option}
              class="mr-2 align-middle text-vintage-berry focus:ring-vintage-berry"
              checked={index === 0}
              required
            />
            {option}
          </label>
        ))
      }
    </div>
  </fieldset>

  <fieldset class="space-y-3">
    <legend class="mb-1 text-sm font-semibold uppercase tracking-wide text-blue-slate">
      {sprinkles.label}
    </legend>
    <div class="flex flex-wrap gap-3">
      {
        sprinkles.options.map((option, index) => (
          <label class="cursor-pointer rounded-lg border border-vintage-berry/20 bg-frozen-water px-4 py-2 text-sm has-[:checked]:border-vintage-berry has-[:checked]:ring-2 has-[:checked]:ring-vintage-berry/30">
            <input
              type="radio"
              name="sprinkles"
              value={option.label}
              data-shows-note={option.showsNoteField ? "true" : "false"}
              data-note-placeholder={option.notePlaceholder}
              class="sprinkles-option mr-2 align-middle text-vintage-berry focus:ring-vintage-berry"
              checked={index === 0}
              required
            />
            {option.label}
          </label>
        ))
      }
    </div>
    <div id="sprinkles-note-wrapper" hidden>
      <label for="sprinkles-note" class="sr-only">Sprinkles note</label>
      <input type="text" id="sprinkles-note" name="sprinkles-note" class="form-input" />
    </div>
  </fieldset>

  <section
    id="selected-product-summary"
    class="rounded-lg border border-vintage-berry/20 bg-frozen-water p-4"
    aria-labelledby={multipleProducts ? "order-form-heading selected-product-summary-label" : "order-form-heading"}
  >
    <div class="mb-4">
      {multipleProducts && (
        <p id="selected-product-summary-label" class="text-xs uppercase tracking-wide text-blue-slate/70">
          {site.order.form.selectedSummaryLabel}
        </p>
      )}
      <h2 id="order-form-heading" class="text-lg font-semibold text-blue-slate">
        {defaultProduct?.name}
      </h2>
      <p class="mt-1 text-sm text-blue-slate/70">{site.order.deliveryNote}</p>
    </div>

    <p id="selected-product-price" class="text-sm text-blue-slate/80">
      {priceDisplay}
    </p>
    <p id="selected-product-serving-info" class:list={["mt-1 text-xs text-blue-slate/70", !defaultProduct?.servingInfo && "hidden"]}>
      {defaultProduct?.servingInfo}
    </p>
    <p id="selected-product-details" class="mt-2 text-sm text-blue-slate/80"></p>
    <p
      id="selected-product-description"
      class:list={["mt-2 text-sm text-blue-slate/75", !defaultProduct?.description && "hidden"]}
    >
      {defaultProduct?.description}
    </p>
  </section>

  <div class="grid gap-4 sm:grid-cols-2">
    <div>
      <label for="name" class="mb-1 block text-sm font-medium text-blue-slate">
        {site.order.form.nameLabel} <span aria-hidden="true">*</span><span class="sr-only"> (required)</span>
      </label>
      <input
        type="text"
        id="name"
        name="name"
        required
        autocomplete="name"
        class="form-input"
      />
    </div>
    <div>
      <label for="email" class="mb-1 block text-sm font-medium text-blue-slate">
        {site.order.form.emailLabel} <span aria-hidden="true">*</span><span class="sr-only"> (required)</span>
      </label>
      <input
        type="email"
        id="email"
        name="email"
        required
        autocomplete="email"
        class="form-input"
      />
    </div>
  </div>

  <div class="grid gap-4 sm:grid-cols-2">
    <div>
      <label for="phone" class="mb-1 block text-sm font-medium text-blue-slate">
        {site.order.form.phoneLabel} <span aria-hidden="true">*</span><span class="sr-only"> (required)</span>
      </label>
      <input
        type="tel"
        id="phone"
        name="phone"
        required
        autocomplete="tel"
        class="form-input"
      />
    </div>
    <div>
      <label for="delivery-date" class="mb-1 block text-sm font-medium text-blue-slate">
        {site.order.form.deliveryDateLabel} <span aria-hidden="true">*</span><span class="sr-only"> (required)</span>
      </label>
      <input
        type="date"
        id="delivery-date"
        name="delivery-date"
        required
        class="form-input"
      />
      <p id="delivery-date-error" role="alert" hidden class="mt-1 text-sm text-nail-polish">
        We're closed Sundays — please choose a different date.
      </p>
    </div>
  </div>

  <input type="hidden" id="product" name="product" value={defaultProduct?.name ?? ""} />

  <fieldset class="space-y-3">
    <legend class="mb-1 text-sm font-semibold uppercase tracking-wide text-blue-slate">
      {fulfillment.label}
    </legend>
    <div class="grid gap-3">
      {
        fulfillment.options.map((option, index) => (
          <label
            class="fulfillment-option block cursor-pointer rounded-lg border border-vintage-berry/20 bg-frozen-water p-4 transition has-[:checked]:border-vintage-berry has-[:checked]:ring-2 has-[:checked]:ring-vintage-berry/30"
            data-requires-address={option.requiresAddress ? "true" : "false"}
          >
            <div class="flex items-start gap-3">
              <input
                type="radio"
                name="fulfillment"
                value={option.label}
                class="mt-1 h-5 w-5 shrink-0 border-soft-blossom text-vintage-berry focus:ring-vintage-berry"
                checked={index === 0}
                required
              />
              <span class="min-w-0">
                <span class="block text-base font-semibold text-blue-slate">{option.label}</span>
                <span class="mt-1 block text-sm text-blue-slate/75">{option.description}</span>
              </span>
            </div>
          </label>
        ))
      }
    </div>
    <div id="delivery-address-fields" hidden class="grid gap-4 sm:grid-cols-2">
      <p class="text-sm font-semibold text-blue-slate sm:col-span-2">{fulfillment.addressLabel}</p>
      <div class="sm:col-span-2">
        <label for="delivery-street" class="mb-1 block text-sm font-medium text-blue-slate">Street address</label>
        <input type="text" id="delivery-street" name="delivery-street" autocomplete="street-address" class="form-input" />
      </div>
      <div>
        <label for="delivery-city" class="mb-1 block text-sm font-medium text-blue-slate">City</label>
        <input type="text" id="delivery-city" name="delivery-city" autocomplete="address-level2" class="form-input" />
      </div>
      <div>
        <label for="delivery-state" class="mb-1 block text-sm font-medium text-blue-slate">State</label>
        <input type="text" id="delivery-state" name="delivery-state" autocomplete="address-level1" class="form-input" />
      </div>
      <div>
        <label for="delivery-zip" class="mb-1 block text-sm font-medium text-blue-slate">ZIP</label>
        <input type="text" id="delivery-zip" name="delivery-zip" autocomplete="postal-code" class="form-input max-w-xs" />
      </div>
    </div>
  </fieldset>

  <div>
    <label for="celebrating" class="mb-1 block text-sm font-medium text-blue-slate">
      {site.order.form.celebratingLabel}
    </label>
    <input type="text" id="celebrating" name="celebrating" class="form-input" />
  </div>

  <div>
    <label for="instructions" class="mb-1 block text-sm font-medium text-blue-slate">
      {site.order.form.instructionsLabel}
    </label>
    <textarea
      id="instructions"
      name="instructions"
      rows="4"
      placeholder={site.order.form.instructionsPlaceholder}
      class="form-input min-h-28"
    ></textarea>
  </div>

  <fieldset class="space-y-3">
    <legend class="mb-1 text-sm font-semibold uppercase tracking-wide text-blue-slate">
      {hearAboutUs.label}
    </legend>
    <div class="flex flex-wrap gap-3">
      {
        hearAboutUs.options.map((option, index) => (
          <label class="cursor-pointer rounded-lg border border-vintage-berry/20 bg-frozen-water px-4 py-2 text-sm has-[:checked]:border-vintage-berry has-[:checked]:ring-2 has-[:checked]:ring-vintage-berry/30">
            <input
              type="radio"
              name="hear-about-us"
              value={option.label}
              data-shows-note={option.showsNoteField ? "true" : "false"}
              data-note-placeholder={option.notePlaceholder}
              class="hear-about-us-option mr-2 align-middle text-vintage-berry focus:ring-vintage-berry"
              checked={index === 0}
              required
            />
            {option.label}
          </label>
        ))
      }
    </div>
    <div id="hear-about-us-note-wrapper" hidden>
      <label for="hear-about-us-note" class="sr-only">Tell us more</label>
      <input type="text" id="hear-about-us-note" name="hear-about-us-note" class="form-input" />
    </div>
  </fieldset>

  <p class="text-sm text-blue-slate/80">{site.order.form.submitDisclaimer}</p>

  <p
    id="order-form-error"
    role="alert"
    hidden
    class="rounded-lg border border-nail-polish/30 bg-nail-polish/10 px-4 py-3 text-sm text-blue-slate"
  >
    {site.order.form.errorMessage}
  </p>

  <button
    id="order-form-submit"
    type="submit"
    class="btn-blush w-full sm:w-auto"
    disabled={!formAction}
    aria-describedby={!formAction ? "form-config-notice" : undefined}
  >
    {site.order.form.submitLabel}
  </button>
</form>

<div
  id="order-form-success"
  hidden
  class="space-y-4 rounded-2xl border border-soft-blossom bg-frozen-water/70 p-6 shadow-sm sm:p-8"
  role="status"
  aria-live="polite"
>
  <h2 class="text-2xl font-semibold text-blue-slate">{site.order.form.successHeading}</h2>
  <p class="text-blue-slate/90">
    Your order request has been sent. {site.order.deliveryNote}
  </p>
  <p class="text-sm text-blue-slate/75">
    {site.order.form.successQuestionsLabel}{" "}
    <a href={`mailto:${site.contact.email}`} class="font-medium text-vintage-berry hover:underline">
      {site.contact.email}
    </a>{" "}
    or{" "}
    <a href={`tel:${site.contact.phone.replace(/\D/g, "")}`} class="font-medium text-vintage-berry hover:underline">
      {site.contact.phone}
    </a>
    .
  </p>
</div>
</div>

<script>
  const dateInput = document.getElementById("delivery-date") as HTMLInputElement | null;
  const dateError = document.getElementById("delivery-date-error");
  if (dateInput) {
    const tomorrow = new Date();
    tomorrow.setDate(tomorrow.getDate() + 1);
    dateInput.min = tomorrow.toISOString().split("T")[0];

    const validateDate = () => {
      const isSunday = Boolean(dateInput.value) && new Date(`${dateInput.value}T00:00:00`).getDay() === 0;
      dateInput.setCustomValidity(isSunday ? "Closed Sundays" : "");
      if (dateError) {
        dateError.hidden = !isSunday;
      }
    };
    dateInput.addEventListener("input", validateDate);
    dateInput.addEventListener("blur", validateDate);
  }

  const cakeTypeInputs = document.querySelectorAll<HTMLInputElement>('input[name="cake-type"]');
  const frostingInputs = document.querySelectorAll<HTMLInputElement>('input[name="frosting"]');
  const sprinklesInputs = document.querySelectorAll<HTMLInputElement>('input[name="sprinkles"]');
  const sprinklesNoteWrapper = document.getElementById("sprinkles-note-wrapper") as HTMLElement | null;
  const sprinklesNoteInput = document.getElementById("sprinkles-note") as HTMLInputElement | null;
  const hearAboutUsInputs = document.querySelectorAll<HTMLInputElement>('input[name="hear-about-us"]');
  const hearAboutUsNoteWrapper = document.getElementById("hear-about-us-note-wrapper") as HTMLElement | null;
  const hearAboutUsNoteInput = document.getElementById("hear-about-us-note") as HTMLInputElement | null;
  const fulfillmentInputs = document.querySelectorAll<HTMLInputElement>('input[name="fulfillment"]');
  const deliveryAddressFields = document.getElementById("delivery-address-fields") as HTMLElement | null;

  const productInput = document.getElementById("product") as HTMLInputElement | null;
  const summaryHeading = document.getElementById("order-form-heading");
  const summaryPrice = document.getElementById("selected-product-price");
  const summaryServingInfo = document.getElementById("selected-product-serving-info");
  const summaryDetails = document.getElementById("selected-product-details");
  const summaryDescription = document.getElementById("selected-product-description");

  const getSelectedProductLabel = () =>
    document.querySelector<HTMLElement>('input[name="product-choice"]:checked')?.closest<HTMLElement>(".product-option") ??
    document.querySelector<HTMLElement>(".product-option");

  const updateSummary = () => {
    const label = getSelectedProductLabel();
    const name = label?.dataset.productName ?? "";
    const regularPrice = label?.dataset.productPrice ?? "Price TBD";
    const glutenFreePrice = label?.dataset.productGlutenFreePrice ?? "";
    const servingInfo = label?.dataset.productServingInfo ?? "";
    const description = label?.dataset.productDescription ?? "";

    const isGlutenFree = document.querySelector<HTMLInputElement>('input[name="cake-type"]:checked')?.value === "gluten-free";
    const price = isGlutenFree && glutenFreePrice ? glutenFreePrice : regularPrice;

    if (productInput) productInput.value = name;
    if (summaryHeading) summaryHeading.textContent = name;
    if (summaryPrice) summaryPrice.textContent = price;
    if (summaryServingInfo) {
      summaryServingInfo.textContent = servingInfo;
      summaryServingInfo.classList.toggle("hidden", !servingInfo);
    }
    if (summaryDescription) {
      summaryDescription.textContent = description;
      summaryDescription.classList.toggle("hidden", !description);
    }
    if (summaryDetails) {
      const cakeTypeLabel = document.querySelector<HTMLInputElement>('input[name="cake-type"]:checked + label, input[name="cake-type"]:checked')?.closest("label")?.textContent?.trim();
      const frostingLabel = document.querySelector<HTMLInputElement>('input[name="frosting"]:checked')?.value;
      const sprinklesLabel = document.querySelector<HTMLInputElement>('input[name="sprinkles"]:checked')?.value;
      summaryDetails.textContent = [cakeTypeLabel, frostingLabel, sprinklesLabel].filter(Boolean).join(" • ");
    }
  };

  document.querySelectorAll<HTMLInputElement>('input[name="product-choice"]').forEach((radio) => {
    radio.addEventListener("change", updateSummary);
  });
  cakeTypeInputs.forEach((radio) => radio.addEventListener("change", updateSummary));
  frostingInputs.forEach((radio) => radio.addEventListener("change", updateSummary));
  sprinklesInputs.forEach((radio) =>
    radio.addEventListener("change", () => {
      updateSummary();
      const showsNote = radio.dataset.showsNote === "true";
      if (sprinklesNoteWrapper) sprinklesNoteWrapper.hidden = !showsNote;
      if (sprinklesNoteInput) sprinklesNoteInput.placeholder = showsNote ? radio.dataset.notePlaceholder ?? "" : "";
    }),
  );
  hearAboutUsInputs.forEach((radio) =>
    radio.addEventListener("change", () => {
      const showsNote = radio.dataset.showsNote === "true";
      if (hearAboutUsNoteWrapper) hearAboutUsNoteWrapper.hidden = !showsNote;
      if (hearAboutUsNoteInput) hearAboutUsNoteInput.placeholder = showsNote ? radio.dataset.notePlaceholder ?? "" : "";
    }),
  );
  fulfillmentInputs.forEach((radio) =>
    radio.addEventListener("change", () => {
      const requiresAddress = radio.closest<HTMLElement>(".fulfillment-option")?.dataset.requiresAddress === "true";
      if (deliveryAddressFields) deliveryAddressFields.hidden = !requiresAddress;
    }),
  );

  updateSummary();

  const orderForm = document.getElementById("order-form") as HTMLFormElement | null;
  const orderFormSuccess = document.getElementById("order-form-success");
  const orderFormError = document.getElementById("order-form-error");
  const orderFormSubmit = document.getElementById("order-form-submit") as HTMLButtonElement | null;
  const submitLabel = orderFormSubmit?.textContent?.trim() ?? "Submit Order Request";

  if (
    orderForm?.dataset.endpoint &&
    orderFormSuccess &&
    orderFormError &&
    orderFormSubmit
  ) {
    orderForm.addEventListener("submit", async (event) => {
      event.preventDefault();
      orderFormError.hidden = true;
      orderFormSubmit.disabled = true;
      orderFormSubmit.textContent = "Sending...";

      try {
        const response = await fetch(orderForm.action, {
          method: "POST",
          body: new FormData(orderForm),
          headers: { Accept: "application/json" },
        });

        if (response.ok) {
          orderForm.hidden = true;
          orderFormSuccess.hidden = false;
          orderFormSuccess.scrollIntoView({
            behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth",
            block: "nearest",
          });
          return;
        }

        orderFormError.hidden = false;
      } catch {
        orderFormError.hidden = false;
      } finally {
        if (!orderForm.hidden) {
          orderFormSubmit.disabled = false;
          orderFormSubmit.textContent = submitLabel;
        }
      }
    });
  }
</script>
