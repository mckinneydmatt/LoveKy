---
import { site } from "../content/site";
import { isStripeConfigured } from "../lib/stripe";

const stripeConfigured = isStripeConfigured();
const priceDisplay = site.order.price ?? "Price TBD";
---

<form
  id="order-form"
  class="space-y-6 rounded-2xl border border-soft-blossom bg-frozen-water/70 p-4 shadow-sm sm:p-8"
  aria-labelledby="order-form-heading"
>
  {!stripeConfigured && (
    <p
      id="form-config-notice"
      role="status"
      class="rounded-lg bg-frozen-water/30 px-4 py-3 text-sm break-words text-blue-slate"
    >
      Stripe is not configured yet. Add your secret key to{" "}
      <code class="break-all text-vintage-berry">STRIPE_SECRET_KEY</code> in a local{" "}
      <code class="break-all text-vintage-berry">.env</code> file (see{" "}
      <code class="break-all text-vintage-berry">.env.example</code>).
    </p>
  )}

  <p
    id="checkout-error"
    role="alert"
    class="hidden rounded-lg border border-vintage-berry/30 bg-soft-blossom/40 px-4 py-3 text-sm text-blue-slate"
  ></p>

  <div class="rounded-lg border border-vintage-berry/20 bg-frozen-water p-4">
    <h2 id="order-form-heading" class="text-lg font-semibold text-blue-slate">
      {site.order.product}
    </h2>
    <p class="mt-1 text-sm text-blue-slate/80">{priceDisplay}</p>
    <p class="mt-2 text-sm text-blue-slate/70">{site.order.deliveryNote}</p>
  </div>

  <div class="grid gap-4 sm:grid-cols-2">
    <div>
      <label for="name" class="mb-1 block text-sm font-medium text-blue-slate">
        Name <span aria-hidden="true">*</span><span class="sr-only"> (required)</span>
      </label>
      <input
        type="text"
        id="name"
        name="name"
        required
        autocomplete="name"
        class="form-input"
      />
    </div>
    <div>
      <label for="email" class="mb-1 block text-sm font-medium text-blue-slate">
        Email <span aria-hidden="true">*</span><span class="sr-only"> (required)</span>
      </label>
      <input
        type="email"
        id="email"
        name="email"
        required
        autocomplete="email"
        class="form-input"
      />
    </div>
  </div>

  <div class="grid gap-4 sm:grid-cols-2">
    <div>
      <label for="phone" class="mb-1 block text-sm font-medium text-blue-slate">
        Phone <span aria-hidden="true">*</span><span class="sr-only"> (required)</span>
      </label>
      <input
        type="tel"
        id="phone"
        name="phone"
        required
        autocomplete="tel"
        class="form-input"
      />
    </div>
    <div>
      <label for="delivery-date" class="mb-1 block text-sm font-medium text-blue-slate">
        Preferred delivery date <span aria-hidden="true">*</span><span class="sr-only"> (required)</span>
      </label>
      <input
        type="date"
        id="delivery-date"
        name="delivery-date"
        required
        class="form-input"
      />
    </div>
  </div>

  <fieldset class="space-y-4">
    <legend class="text-sm font-semibold uppercase tracking-wide text-blue-slate">
      Delivery address <span aria-hidden="true">*</span>
    </legend>
    <div>
      <label for="delivery-address" class="mb-1 block text-sm font-medium text-blue-slate">
        Street address
      </label>
      <input
        type="text"
        id="delivery-address"
        name="delivery-address"
        required
        autocomplete="street-address"
        class="form-input"
      />
    </div>
    <div class="grid gap-4 sm:grid-cols-2">
      <div>
        <label for="delivery-city" class="mb-1 block text-sm font-medium text-blue-slate">
          City
        </label>
        <input
          type="text"
          id="delivery-city"
          name="delivery-city"
          required
          autocomplete="address-level2"
          class="form-input"
        />
      </div>
      <div>
        <label for="delivery-zip" class="mb-1 block text-sm font-medium text-blue-slate">
          ZIP code
        </label>
        <input
          type="text"
          id="delivery-zip"
          name="delivery-zip"
          required
          inputmode="numeric"
          autocomplete="postal-code"
          class="form-input"
        />
      </div>
    </div>
  </fieldset>

  <div>
    <label for="quantity" class="mb-1 block text-sm font-medium text-blue-slate">Quantity</label>
    <input
      type="number"
      id="quantity"
      name="quantity"
      min="1"
      value="1"
      inputmode="numeric"
      class="form-input max-w-xs"
    />
  </div>

  <div>
    <label for="instructions" class="mb-1 block text-sm font-medium text-blue-slate">
      Special instructions
    </label>
    <textarea
      id="instructions"
      name="instructions"
      rows="4"
      placeholder="Allergies, occasion, decoration requests..."
      class="form-input min-h-28"
    ></textarea>
  </div>

  {
    site.order.ingredients && (
      <div>
        <h3 class="mb-2 text-sm font-semibold uppercase tracking-wide text-blue-slate">
          Ingredients
        </h3>
        <p class="text-sm text-blue-slate/80">{site.order.ingredients}</p>
      </div>
    )
  }

  <div class="rounded-lg border border-blue-slate/10 bg-soft-blossom/20 p-4">
    <p id="order-disclaimer" class="text-sm font-medium text-blue-slate">
      {site.order.disclaimer}
    </p>
    <div class="mt-3 flex items-start gap-3">
      <input
        type="checkbox"
        id="disclaimer-ack"
        name="disclaimer-ack"
        required
        aria-describedby="order-disclaimer"
        class="mt-1 h-5 w-5 shrink-0 rounded border-soft-blossom text-vintage-berry focus:ring-vintage-berry"
      />
      <label for="disclaimer-ack" class="cursor-pointer text-sm text-blue-slate/90">
        I understand and agree to the above disclaimer. <span aria-hidden="true">*</span><span class="sr-only"> (required)</span>
      </label>
    </div>
  </div>

  <button
    type="submit"
    id="checkout-submit"
    class="btn-primary w-full sm:w-auto"
    disabled={!stripeConfigured}
    aria-describedby={!stripeConfigured ? "form-config-notice" : undefined}
  >
    Proceed to payment
  </button>
</form>

<script>
  const form = document.getElementById("order-form") as HTMLFormElement | null;
  const dateInput = document.getElementById("delivery-date") as HTMLInputElement | null;
  const submitButton = document.getElementById("checkout-submit") as HTMLButtonElement | null;
  const errorBox = document.getElementById("checkout-error") as HTMLParagraphElement | null;

  if (dateInput) {
    const tomorrow = new Date();
    tomorrow.setDate(tomorrow.getDate() + 1);
    dateInput.min = tomorrow.toISOString().split("T")[0];
  }

  function showError(message: string) {
    if (!errorBox) return;
    errorBox.textContent = message;
    errorBox.classList.remove("hidden");
  }

  function clearError() {
    if (!errorBox) return;
    errorBox.textContent = "";
    errorBox.classList.add("hidden");
  }

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    clearError();

    if (!submitButton) return;

    const formData = new FormData(form);
    const disclaimerAck = formData.get("disclaimer-ack") === "on";

    const payload = {
      name: String(formData.get("name") ?? "").trim(),
      email: String(formData.get("email") ?? "").trim(),
      phone: String(formData.get("phone") ?? "").trim(),
      deliveryDate: String(formData.get("delivery-date") ?? "").trim(),
      quantity: Number(formData.get("quantity") ?? 1),
      deliveryAddress: String(formData.get("delivery-address") ?? "").trim(),
      deliveryCity: String(formData.get("delivery-city") ?? "").trim(),
      deliveryZip: String(formData.get("delivery-zip") ?? "").trim(),
      instructions: String(formData.get("instructions") ?? "").trim(),
      disclaimerAck,
    };

    submitButton.disabled = true;
    submitButton.textContent = "Redirecting to payment…";

    try {
      const response = await fetch("/api/checkout", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });

      const data = await response.json().catch(() => ({}));

      if (!response.ok || !data.url) {
        showError(data.error ?? "Unable to start checkout. Please try again.");
        submitButton.disabled = false;
        submitButton.textContent = "Proceed to payment";
        return;
      }

      window.location.href = data.url;
    } catch {
      showError("Unable to reach the payment service. Please try again.");
      submitButton.disabled = false;
      submitButton.textContent = "Proceed to payment";
    }
  });
</script>
