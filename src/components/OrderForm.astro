---
import type { Product } from "../content/products";
import type { SiteConfig } from "../content/site";

interface Props {
  site: SiteConfig;
  products: Product[];
}

const { site, products } = Astro.props;

const formAction = site.formEndpoints.order || undefined;
const defaultProduct = products[0];
---

<form
  class="space-y-6 rounded-2xl border border-soft-blossom bg-frozen-water/70 p-4 shadow-sm sm:p-8"
  method="POST"
  action={formAction}
  aria-labelledby="order-form-heading"
>
  {!formAction && (
    <p
      id="form-config-notice"
      role="status"
      class="rounded-lg bg-frozen-water/30 px-4 py-3 text-sm break-words text-blue-slate"
    >
      Formspree is not configured yet. Add your endpoint URL in Sanity under{" "}
      <strong class="text-vintage-berry">Site Settings → Formspree order endpoint</strong>.
    </p>
  )}

  <fieldset class="space-y-3">
    <legend class="mb-1 text-sm font-semibold uppercase tracking-wide text-blue-slate">
      Choose your cake <span aria-hidden="true">*</span>
    </legend>
    <div class="grid gap-3">
      {
        products.map((product, index) => {
          const priceDisplay = product.price ?? "Price TBD";
          return (
            <label
              class="product-option block cursor-pointer rounded-lg border border-vintage-berry/20 bg-frozen-water p-4 transition has-[:checked]:border-vintage-berry has-[:checked]:ring-2 has-[:checked]:ring-vintage-berry/30"
              data-product-id={product.id}
              data-product-name={product.name}
              data-product-price={priceDisplay}
              data-product-ingredients={product.ingredients ?? ""}
            >
              <div class="flex items-start gap-3">
                <input
                  type="radio"
                  name="product-choice"
                  value={product.id}
                  class="mt-1 h-5 w-5 shrink-0 border-soft-blossom text-vintage-berry focus:ring-vintage-berry"
                  checked={index === 0}
                  required
                />
                <span class="min-w-0">
                  <span class="block text-base font-semibold text-blue-slate">{product.name}</span>
                  <span class="mt-1 block text-sm text-vintage-berry">{priceDisplay}</span>
                  {product.description && (
                    <span class="mt-2 block text-sm text-blue-slate/75">{product.description}</span>
                  )}
                </span>
              </div>
            </label>
          );
        })
      }
    </div>
  </fieldset>

  <div
    id="selected-product-summary"
    class="rounded-lg border border-vintage-berry/20 bg-frozen-water p-4"
  >
    <h2 id="order-form-heading" class="text-lg font-semibold text-blue-slate">
      {defaultProduct?.name}
    </h2>
    <p id="selected-product-price" class="mt-1 text-sm text-blue-slate/80">
      {defaultProduct?.price ?? "Price TBD"}
    </p>
    <p class="mt-2 text-sm text-blue-slate/70">{site.order.deliveryNote}</p>
    <p
      id="selected-product-ingredients"
      class:list={["mt-3 text-sm text-blue-slate/80", !defaultProduct?.ingredients && "hidden"]}
    >
      {
        defaultProduct?.ingredients && (
          <>
            <span class="font-semibold uppercase tracking-wide">Ingredients:</span>{" "}
            {defaultProduct.ingredients}
          </>
        )
      }
    </p>
  </div>

  <div class="grid gap-4 sm:grid-cols-2">
    <div>
      <label for="name" class="mb-1 block text-sm font-medium text-blue-slate">
        Name <span aria-hidden="true">*</span><span class="sr-only"> (required)</span>
      </label>
      <input
        type="text"
        id="name"
        name="name"
        required
        autocomplete="name"
        class="form-input"
      />
    </div>
    <div>
      <label for="email" class="mb-1 block text-sm font-medium text-blue-slate">
        Email <span aria-hidden="true">*</span><span class="sr-only"> (required)</span>
      </label>
      <input
        type="email"
        id="email"
        name="email"
        required
        autocomplete="email"
        class="form-input"
      />
    </div>
  </div>

  <div class="grid gap-4 sm:grid-cols-2">
    <div>
      <label for="phone" class="mb-1 block text-sm font-medium text-blue-slate">
        Phone <span aria-hidden="true">*</span><span class="sr-only"> (required)</span>
      </label>
      <input
        type="tel"
        id="phone"
        name="phone"
        required
        autocomplete="tel"
        class="form-input"
      />
    </div>
    <div>
      <label for="delivery-date" class="mb-1 block text-sm font-medium text-blue-slate">
        Preferred delivery date <span aria-hidden="true">*</span><span class="sr-only"> (required)</span>
      </label>
      <input
        type="date"
        id="delivery-date"
        name="delivery-date"
        required
        class="form-input"
      />
    </div>
  </div>

  <div>
    <label for="quantity" class="mb-1 block text-sm font-medium text-blue-slate">Quantity</label>
    <input
      type="number"
      id="quantity"
      name="quantity"
      min="1"
      value="1"
      inputmode="numeric"
      class="form-input max-w-xs"
    />
  </div>

  <input type="hidden" id="product" name="product" value={defaultProduct?.name ?? ""} />

  <div>
    <label for="instructions" class="mb-1 block text-sm font-medium text-blue-slate">
      Special instructions
    </label>
    <textarea
      id="instructions"
      name="instructions"
      rows="4"
      placeholder="Allergies, occasion, decoration requests..."
      class="form-input min-h-28"
    ></textarea>
  </div>

  <div class="rounded-lg border border-blue-slate/10 bg-soft-blossom/20 p-4">
    <p id="order-disclaimer" class="text-sm font-medium text-blue-slate">
      {site.order.disclaimer}
    </p>
    <div class="mt-3 flex items-start gap-3">
      <input
        type="checkbox"
        id="disclaimer-ack"
        name="disclaimer-ack"
        required
        aria-describedby="order-disclaimer"
        class="mt-1 h-5 w-5 shrink-0 rounded border-soft-blossom text-vintage-berry focus:ring-vintage-berry"
      />
      <label for="disclaimer-ack" class="cursor-pointer text-sm text-blue-slate/90">
        I understand and agree to the above disclaimer. <span aria-hidden="true">*</span><span class="sr-only"> (required)</span>
      </label>
    </div>
  </div>

  <button
    type="submit"
    class="btn-primary w-full sm:w-auto"
    disabled={!formAction}
    aria-describedby={!formAction ? "form-config-notice" : undefined}
  >
    Submit Order Request
  </button>
</form>

<script>
  const dateInput = document.getElementById("delivery-date") as HTMLInputElement | null;
  if (dateInput) {
    const tomorrow = new Date();
    tomorrow.setDate(tomorrow.getDate() + 1);
    dateInput.min = tomorrow.toISOString().split("T")[0];
  }

  const productInput = document.getElementById("product") as HTMLInputElement | null;
  const summaryHeading = document.getElementById("order-form-heading");
  const summaryPrice = document.getElementById("selected-product-price");
  const summaryIngredients = document.getElementById("selected-product-ingredients");

  const updateSelectedProduct = (label: HTMLElement) => {
    const name = label.dataset.productName ?? "";
    const price = label.dataset.productPrice ?? "Price TBD";
    const ingredients = label.dataset.productIngredients ?? "";

    if (productInput) {
      productInput.value = name;
    }
    if (summaryHeading) {
      summaryHeading.textContent = name;
    }
    if (summaryPrice) {
      summaryPrice.textContent = price;
    }
    if (summaryIngredients) {
      if (ingredients) {
        summaryIngredients.innerHTML = `<span class="font-semibold uppercase tracking-wide">Ingredients:</span> ${ingredients}`;
        summaryIngredients.classList.remove("hidden");
      } else {
        summaryIngredients.textContent = "";
        summaryIngredients.classList.add("hidden");
      }
    }
  };

  document.querySelectorAll<HTMLInputElement>('input[name="product-choice"]').forEach((radio) => {
    radio.addEventListener("change", () => {
      const label = radio.closest<HTMLElement>(".product-option");
      if (label) {
        updateSelectedProduct(label);
      }
    });
  });
</script>
