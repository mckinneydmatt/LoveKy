---
interface Props {
  quote: string;
  author: string;
  isPlaceholder?: boolean;
}

const { quote, author, isPlaceholder = false } = Astro.props;
---

<blockquote class="rounded-2xl border border-soft-blossom bg-frozen-water/60 p-5 shadow-sm sm:p-6">
  <img
    src="/icons/filled-heart-red.png"
    alt=""
    class="mb-3 h-5 w-5 opacity-80"
    width="20"
    height="20"
    aria-hidden="true"
  />
  <p class="mb-4 text-blue-slate/90 italic">&ldquo;{quote}&rdquo;</p>
  <footer class="text-sm font-medium text-blue-slate">
    <cite class="not-italic">— {author}</cite>
    {isPlaceholder && (
      <span class="ml-2 text-xs font-normal uppercase tracking-wide text-powder-blush">
        <span class="sr-only">Placeholder review. </span>
        <span aria-hidden="true">Placeholder</span>
      </span>
    )}
  </footer>
</blockquote>
