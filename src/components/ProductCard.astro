---
import type { Product } from "../content/products";

interface Props {
  product: Product;
}

const { product } = Astro.props;
const priceDisplay = product.price ?? "Price TBD";
---

<article class="flex h-full flex-col rounded-2xl border border-soft-blossom bg-frozen-water/70 p-6 shadow-sm">
  <h3 class="text-lg font-semibold text-blue-slate">{product.name}</h3>
  <p class="mt-1 text-sm font-medium text-vintage-berry">{priceDisplay}</p>
  {
    product.description && (
      <p class="mt-3 flex-1 text-sm leading-relaxed text-blue-slate/80">{product.description}</p>
    )
  }
  <a href="/order" class="btn-secondary mt-6 w-full sm:w-auto">
    Order this cake
  </a>
</article>
