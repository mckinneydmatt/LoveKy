---
import type { SiteConfig } from "../content/site";

interface Props {
  site: SiteConfig;
}

const { site } = Astro.props;
---

<footer class="mt-auto border-t border-soft-blossom bg-blue-slate text-frozen-water">
  <div class="container-page grid gap-8 py-10 text-center sm:grid-cols-2 sm:text-left lg:grid-cols-3">
    <div class="flex flex-col items-center sm:items-start">
      <img
        src={site.logos.secondary}
        alt=""
        class="mb-4 h-12 w-auto"
        width="180"
        height="48"
        aria-hidden="true"
      />
      {site.tagline && (
        <p class="tagline mb-2 text-lg text-soft-blossom">{site.tagline}</p>
      )}
      <p class="text-sm text-frozen-water/80">{site.contact.location}</p>
    </div>

    <div>
      <h2 class="mb-3 text-sm font-semibold uppercase tracking-widest text-soft-blossom">
        Get in touch
      </h2>
      <ul class="space-y-2 text-sm">
        <li>
          <a
            href={`mailto:${site.contact.email}`}
            class="inline-flex min-h-11 items-center justify-center break-all hover:text-soft-blossom sm:justify-start"
          >
            {site.contact.email}
          </a>
        </li>
        <li>
          <a
            href={`tel:${site.contact.phone}`}
            class="inline-flex min-h-11 items-center justify-center hover:text-soft-blossom sm:justify-start"
          >
            {site.contact.phone}
          </a>
        </li>
        <li class="text-frozen-water/80">{site.contact.hours}</li>
      </ul>
    </div>

    <div>
      <h2 class="mb-3 text-sm font-semibold uppercase tracking-widest text-soft-blossom">
        Follow along
      </h2>
      <a
        href={site.social.instagram}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`${site.social.handle} on Instagram (opens in new tab)`}
        class="inline-flex min-h-11 items-center justify-center gap-2 text-sm hover:text-soft-blossom sm:justify-start"
      >
        {site.social.handle}
      </a>
    </div>
  </div>

  <div class="border-t border-frozen-water/10 py-4 text-center text-xs text-frozen-water/60">
    &copy; {new Date().getFullYear()} {site.name}. All rights reserved.
  </div>
</footer>
