---
import type { SiteConfig } from "../content/site";
import SocialIcon from "./SocialIcon.astro";

interface Props {
  site: SiteConfig;
}

const { site } = Astro.props;
---

<footer class="mt-auto border-t border-soft-blossom bg-blue-slate text-frozen-water">
  <div class="container-page grid gap-8 py-8 text-center sm:grid-cols-2 sm:py-10 sm:text-left lg:grid-cols-3">
    <div class="flex flex-col items-center sm:items-start">
      <a href="/" class="mb-4 shrink-0" aria-label={`${site.name} home`}>
        <img
          src={site.logos.secondary}
          alt=""
          class="h-12 w-auto"
          width="180"
          height="48"
          aria-hidden="true"
        />
      </a>
      {site.tagline && (
        <p class="tagline mb-2 text-base text-soft-blossom sm:text-lg">{site.tagline}</p>
      )}
      <address class="text-sm not-italic text-frozen-water/80">
        {site.contact.address.street}<br />
        {site.contact.address.city}, {site.contact.address.state} {site.contact.address.zip}
      </address>
    </div>

    <div>
      <h2 class="mb-3 text-sm font-semibold uppercase tracking-widest text-soft-blossom">
        Get in touch
      </h2>
      <ul class="space-y-1 text-sm leading-snug">
        <li>
          <a
            href={`mailto:${site.contact.email}`}
            class="inline-flex items-center justify-center break-all py-0.5 hover:text-soft-blossom sm:justify-start"
          >
            {site.contact.email}
          </a>
        </li>
        <li>
          <a
            href={`tel:${site.contact.phone}`}
            class="inline-flex items-center justify-center py-0.5 hover:text-soft-blossom sm:justify-start"
          >
            {site.contact.phone}
          </a>
        </li>
        <li class="py-0.5 text-frozen-water/80">{site.contact.hours}</li>
      </ul>
    </div>

    <div>
      <h2 class="mb-3 text-sm font-semibold uppercase tracking-widest text-soft-blossom">
        Follow along
      </h2>
      <ul class="space-y-1 text-sm leading-snug">
        {
          site.social.links.map((link) => (
            <li>
              <a
                href={link.url}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${link.label} on ${link.name} (opens in new tab)`}
                class="inline-flex items-center justify-center gap-2.5 py-0.5 hover:text-soft-blossom sm:justify-start"
              >
                <SocialIcon name={link.icon} />
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="border-t border-frozen-water/10 py-4 text-center text-xs text-frozen-water/60">
    &copy; {new Date().getFullYear()} {site.name}. All rights reserved.
  </div>
</footer>
