---
interface Props {
  name: "instagram" | "tiktok" | "facebook";
  class?: string;
}

const { name, class: className = "h-5 w-5" } = Astro.props;
---

{
  name === "instagram" && (
    <svg
      class={className}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.75"
      aria-hidden="true"
    >
      <rect x="3" y="3" width="18" height="18" rx="5" />
      <circle cx="12" cy="12" r="4" />
      <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
    </svg>
  )
}
{
  name === "tiktok" && (
    <svg class={className} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M16.5 5.5c1.1.8 2.4 1.3 3.8 1.3V10c-1.3 0-2.5-.4-3.5-1.1v5.8c0 3.4-2.8 6.2-6.2 6.2S4.4 17.1 4.4 13.7s2.8-6.2 6.2-6.2c.3 0 .7 0 1 .1v3.3a3 3 0 0 0-1-.2 2.9 2.9 0 0 0 0 5.8 2.9 2.9 0 0 0 2.9-2.9V3h3.1c.1 1 .5 1.9 1.1 2.5Z" />
    </svg>
  )
}
{
  name === "facebook" && (
    <svg class={className} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M14 8.5V7.2c0-.7.6-1 1.1-1H17V3h-2.4C12.2 3 11 4.8 11 7v1.5H9v3.2h2V21h3v-9.3h2.3l.4-3.2H14Z" />
    </svg>
  )
}
